<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 長時間の連続推論（サーマル試験は5分）中に OS に停止されないため -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk 34 では foregroundServiceType に対応する権限が必須 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ の通知権限。未付与でも Service は動くが adb から付与しておく -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      画面消灯のまま連続実行するために PARTIAL_WAKE_LOCK を取る。
      これを宣言し忘れると acquire() が SecurityException を投げ、
      Service が起動直後に落ちる（2026-09-12 に実際に踏んだ）。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- チャット画面（ChatActivity）で「通信なし（機内モード）」かどうかを表示するため。通信はしない -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="VLM 検証"
        android:allowBackup="false"
        android:supportsRtl="false">

        <!--
          ★★ これが無いと NPU は一切使えない（2026-09-12 に半日かけて突き止めた）

          Android 12+（API 31以降）では、アプリが vendor のネイティブライブラリを
          dlopen するには <uses-native-library> での明示宣言が必要。宣言しないと
          アプリのリンカ名前空間に入らず、FastRPC クライアント libcdsprpc.so に
          到達できない。

          症状は真因を示さない:
            E qnn_execution_provider.cc GetCapability] QNN SetupBackend failed
              Failed to create device. Error: QNN_DEVICE_ERROR_INVALID_CONFIG
            → その後 "EPContext node is not compatible with any execution provider"

          「config が不正」と言われるが実際は「DSP に繋がれない」状態である。
          required=false にしているのは、DSP を持たない端末でもアプリ自体は
          起動できるようにするため（ZipDepth も同じ）。
        -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />

        <!--
          デモ画面。ランチャーから起動されるのはこちら。
          セッション（772MB）はこの画面が持ち、開いたまま生成を繰り返す。
        -->
        <activity
            android:name=".DemoActivity"
            android:exported="true"
            android:label="EdgeSLM Demo"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Gemma4 検証アプリでは Qwen 用の画面にアイコンを出さない（Qwen のモデルが無いので動かない。2026-09-20） -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          KVキャッシュ版のデモ画面。**ランチャーに2つ目のアイコンとして出る。**

          窓ずらし版（DemoActivity）とは独立した Activity にしてある。
          あちらは既に検証を通した経路なので、そこへ手を入れずに並べたい、という理由。

          ★2つを同時に開かないこと。2026-09-19 に測り直した結果、772MB×2 の保持自体はできるが、
            ロード中の一時的なメモリ要求で lmkd に kill されうる。1プロセスの NPU 側上限も約1,710MiB
            （EdgeSLM_AndroidScale P0A）。
            片方を開くともう片方は閉じる作りにしてある。
        -->
        <activity
            android:name=".KvDemoActivity"
            android:exported="true"
            android:label="EdgeSLM KV"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Gemma4 検証アプリでは Qwen 用の画面にアイコンを出さない（Qwen のモデルが無いので動かない。2026-09-20） -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          同僚に見せるためのチャット画面（EdgeSLM_AndroidScale の成果。2026-09-19）。
          1.5B（賢い）と 0.5B（速い）を切り替えて会話できる。起動時は 1.5B。
          技術者向けの2画面（窓ずらし版・KV 版）はそのまま残してある。
          ★ほかの画面と同時にモデルを開かないこと（1プロセスの NPU 上限 約1,710MiB）。
          ★configChanges: ダークモードの自動切り替え・文字の大きさ・キーボードの抜き差しなどで画面を
            作り直さない（作り直すと会話が消え、モデルを読み込み直す）。画面はコードで組み、色も固定なので作り直す必要がない。
        -->
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:label="Gemma4 チャット"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- VLM 検証アプリ（2026-09-29）: このアプリにはまだチャット用のモデルを置かないので、ランチャーに出さない。
                     Phase 2 は PC から RunnerActivity に job を渡して動かす。Phase 3 で画像つきの画面を入口にする -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          ★VLM デモ（EdgeSLM_AndroidVLM Phase 3、2026-09-29）。**このアプリの入口**。
          写真を撮って日本語で質問すると、画像エンコーダ（別プロセス :probe の RunnerService2）と
          文章側（この画面が開いたまま持つ 1,467MiB）の両方を NPU で動かして答える。
          カメラの権限は宣言しない（撮影はカメラアプリに頼み、MediaStore に保存させる。
          宣言すると、権限を許可していないときに ACTION_IMAGE_CAPTURE が SecurityException になる）。
          configChanges: カメラから戻るときの回転などで画面を作り直さない（作り直すとモデルを読み直す）。
        -->
        <activity
            android:name=".VlmActivity"
            android:exported="true"
            android:label="VLM デモ"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          検証用の入口（コピー元 EdgeSLM_Android/android_runner と同じ）。UI は持たない。
          役割は2つ: ①インストール直後の「stopped 状態」から抜ける入口
                     ②Foreground Service をフォアグラウンド文脈から起動する
                       （Android 12+ はバックグラウンドからの FGS 起動を制限するため）
          UI は持たず、adb の am start に job を渡して叩く（XML コメント内に連続ハイフンは書けない）。
          **デモ画面とは独立に残してある**——P0〜P4 の再現手順を壊さないため。
        -->
        <activity
            android:name=".RunnerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.edgeslm.demo.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          ★画面を前に出したまま job を動かす入口（EdgeSLM_AndroidVLM Phase 3、2026-09-29）。
          1.5GB のモデルを開く間（一時的に約 3.1GB 使う）、画面が裏だと OS（lmkd）に止められることがある。
          画面が前にあれば止められない（EdgeSLM_AndroidScale P3 で 25/25）。RunnerActivity は Theme.NoDisplay で
          画面を残せないので、別の入口にした（RunnerActivity の P0〜P4 の再現手順は変えない）。
          結果のファイルが書かれたら自分で閉じる。PC の道具は device_vit.run_job(..., hold=True) で使う。
          configChanges: 回転などで作り直さない（作り直しても job は二重に起こさない作りだが、表示が途切れないように）。
        -->
        <activity
            android:name=".RunnerHoldActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!--
          exported=true にしているのは adb（shell uid）から am で起動するため。
          本アプリは検証用であり、一般配布しない。
        -->
        <service
            android:name=".RunnerService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />

        <!--
          別プロセス（:probe）で動く2つ目の入口（2026-09-21、検証用）。
          NPU の上限（約1,710MiB）はプロセス単位なので、**1.5GB のグラフを2つ同時に開けるか**を実機で確かめる。
          通れば「入力を食べる用」と「答えを作る用」を常駐でき、持ち替えの 2.5秒が消える（P6 2.5節）。
        -->
        <activity
            android:name=".RunnerActivity2"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":probe"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.edgeslm.demo.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".RunnerService2"
            android:exported="true"
            android:process=":probe"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
